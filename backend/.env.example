# Copy to .env for local runs (`npm run dev`, `npm test`). Never commit .env.
# Every variable is described in docs/ARCHITECTURE.md §12.

# development or production; required. production makes the admin cookie Secure (D-137)
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Postgres from `docker compose up db`. Inside Compose, the api container uses host `db` instead (docker-compose.yml)
DATABASE_URL=postgres://nyx:nyx@localhost:5432/nyx

# true only behind the hosting platform's proxy, so rate limits see real client IPs
TRUST_PROXY=false

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# The one admin login for the console (A-16). No password or secret is ever committed, not even a dev one (D-137):
# ADMIN_PASSWORD_HASH ← run `npm run hash-password` and paste its line here
# SESSION_SECRET      ← node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing SESSION_SECRET logs the admin out everywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Tests only: a separate database, emptied before each test (D-129)
TEST_DATABASE_URL=postgres://nyx:nyx@localhost:5432/nyx_test
