{
  "name": "nyx-backend",
  "version": "1.0.0",
  "description": "Nyx API: serves the config document, takes opt-in stats, hosts the admin console",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "test:coverage": "node --env-file-if-exists=.env --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/features/**' --test-coverage-lines=80",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
