<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the dev backend through `adb reverse tcp:3000 tcp:3000`, and nothing else (D-142).
     Release builds have no config, so Android refuses all plain HTTP (§9) -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
